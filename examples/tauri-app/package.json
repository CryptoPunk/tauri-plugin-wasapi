{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:msvc": "bun run tauri build -- --runner xwin --target x86_64-pc-windows-msvc",
    "tauri:check": "cargo xwin check --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "clean": "bun run tauri:clean && rm -rf dist",
    "distclean": "bun run clean && rm -rf node_modules && rm -rf bun.lock && rm -rf src-tauri/Cargo.lock",
    "tauri:clean": "cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "tauri-plugin-wasapi-api": "file:../../"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}