{
  "name": "tauri-plugin-wasapi-api",
  "version": "0.1.0",
  "author": "Max Vohra <max-oss@seattlenetworks.com>",
  "description": "TypeScript API for tauri-plugin-wasapi",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "bun run build",
    "cargo:check": "cargo xwin check --target x86_64-pc-windows-msvc",
    "cargo:build": "cargo xwin build --target x86_64-pc-windows-msvc",
    "pretest": "bun run build",
    "clean": "bun run tauri:clean && rm -rf dist-js",
    "distclean": "bun run clean && rm -rf node_modules && rm -rf bun.lock && rm -rf Cargo.lock",
    "tauri:clean": "cargo clean",
    "docs:rust": "cargo doc --no-deps --target-dir docs/public/api/rust",
    "docs:ts": "typedoc --out docs/public/api/ts",
    "docs:inject": "bun run scripts/inject-api-nav.mjs docs/public/api/ts docs/public/api/rust/doc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run docs:rust && bun run docs:ts && bun run docs:inject && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:clean": "rm -rf docs/public/api/rust && rm -rf docs/public/api/ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "mermaid": "^11.14.0",
    "typedoc": "v0.28.18",
    "typedoc-theme-oxide": "^0.2.5",
    "typescript": "^5.9.3",
    "vite": "v8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}